{
  "name": "@weebforge/nlp",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "A lightweight ForgeScript extension for the Node.js 'natural' library",
  "keywords": [
    "ForgeNLP",
    "nlp",
    "natural",
    "language",
    "weebforge",
    "forge",
    "forgescript",
    "tryforge"
  ],
  "homepage": "https://github.com/weebforge/ForgeNLP#readme",
  "bugs": {
    "url": "https://github.com/weebforge/ForgeNLP/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weebforge/ForgeNLP.git"
  },
  "license": "GPL-3.0-or-later",
  "author": "lezii",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prepublishOnly": "tsc",
    "build": "tsc -p tsconfig.json",
    "docgen": "npm run eslint && npm run build && typedoc ./src --plugin typedoc-rhineai-theme --out ./docs && node dist/docgen",
    "eslint": "eslint ./src/**/* --fix && prettier src --write",
    "commit": "npm run docgen && node dist/@build/commit",
    "test": "npm run build && node dist/__scripts__/index"
  },
  "devDependencies": {
    "@tryforge/forgescript": "github:tryforge/ForgeScript#dev",
    "@types/node": "^25.0.9",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.0",
    "typedoc": "^0.28.16",
    "typedoc-rhineai-theme": "^1.2.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "natural": "^8.1.1"
  }
}
